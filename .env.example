# Application Settings
PORT=8080
# Host address the published port binds to (127.0.0.1 = local only, use a TLS reverse proxy)
BIND_ADDR=127.0.0.1
# Leave empty to auto-generate a secret stored next to the database, or use >= 32 random characters
JWT_SECRET=
ADMIN_USER=admin
# Leave empty to generate a random initial admin password (printed once in the logs)
ADMIN_PASSWORD=
TRUST_PROXY=false
# Comma-separated proxy CIDRs whose forwarding headers are trusted (default: loopback and private ranges)
TRUSTED_PROXIES=
# Comma-separated extra origins allowed for CORS and WebSockets (the panel itself is always allowed)
ALLOWED_ORIGINS=
# Host directory under which bind mounts are allowed for created containers (empty = named volumes only)
ALLOWED_BIND_ROOT=
# Comma-separated image prefixes allowed for created containers, e.g. docker.io/library/,ghcr.io/myorg/ (empty = any)
ALLOWED_IMAGE_PREFIXES=

# Database
DATABASE_URL=dgsmgt.db

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
