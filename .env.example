# Application Settings
PORT=8080
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
ALLOWED_ORIGINS=

# Database
DATABASE_URL=dgsmgt.db

# Docker creation is disabled until immutable image references are allow-listed.
# Example: registry.example/game@sha256:<64 lowercase hex characters>
ALLOWED_IMAGES=
# Only these exact comma-separated absolute host directories may be bound.
ALLOWED_VOLUME_ROOTS=/srv/dgsmgt
DOCKER_PROXY_SOCKET=/run/dgsmgt/docker-proxy.sock
